APP_NAME=raster-to-svg
APP_VERSION=0.1.0
MAX_FILE_SIZE_MB=20
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=50000000
MAX_CONCURRENT_JOBS=2
API_KEY_REQUIRED=false
API_KEY=
ALLOW_ORIGINS=*
LOG_LEVEL=INFO
# Pillow enhance: auto (on for photo only), always, or never.
# Per-request pillow_enhance=true|false overrides this.
# Photo path is quantize + color-merge only (see preprocess_pillow.py).
PILLOW_ENHANCE=auto
