APP_NAME=raster-to-svg
APP_VERSION=0.1.0
MAX_FILE_SIZE_MB=20
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
MAX_IMAGE_PIXELS=50000000
MAX_CONCURRENT_JOBS=2
API_KEY_REQUIRED=false
API_KEY=
ALLOW_ORIGINS=*
LOG_LEVEL=INFO
# Optional Pillow enhance (quantize / color-merge / AA fringe / soften).
# Default false = native VTracer 1.x only. Set true to A/B; delete
# app/services/preprocess_pillow.py if it proves useless.
PILLOW_ENHANCE=false
